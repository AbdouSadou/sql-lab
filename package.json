{
  "name": "sql-playground",
  "private": true,
  "description": "Dev tooling for the SQL playground: the tests, and the two build steps (the CodeMirror bundle in vendor/editor.js, and the app page's scripts and stylesheets in bundle/, both committed). The site itself is served as is.",
  "scripts": {
    "test": "playwright test",
    "build:editor": "node tools/build-editor.mjs",
    "build:app": "node tools/build-app.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.61.0"
  },
  "overrides": {
    "@lezer/common": "1.5.4",
    "@lezer/lr": "1.4.11"
  }
}
